#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/backlight.h>

#define BASE  0
#define SYMJ  1
#define SYM   2
#define DEF   3
#define BREV  4
#define JIS   5
#define JISR  6
#define BLNX  7
#define KP    8
#define FN    9
#define FNJIS 10
#define MOD   11

#define LCS LC(LSHFT)
#define RCS RC(RSHFT)
#define LCA LC(LALT)
#define RCA RC(RALT)
#define HYP LC(LS(LA(LGUI)))
#define MEH LC(LS(LALT))
#define CAD LC(LA(DEL))
#define CAI LC(LA(INS))
#define SI  LS(INS)
#define ST  LG(TAB)
#define GG  LG(GRAVE)

&caps_word {
  continue-list = <UNDERSCORE MINUS LS(INT1) BACKSPACE DELETE>;
};

&sk {
  release-after-ms = <200>;
  quick-release;
};

/ {
    behaviors {
      #include "macros.dtsi"
      #include "version.dtsi"
      #include "ansi-jis.dtsi"
      #include "switch_bt.dtsi"
      #ifndef VERSION_MACRO
      macro_ver: macro_ver {
        compatible = "zmk,behavior-macro";
        label = "macro_version";
        #binding-cells = <0>;
        bindings = <&kp RET>;
      };
      #endif

      hm: homerow_mods {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <180>;
          flavor = "tap-preferred";
          bindings = <&kp>, <&kp>;
      };

      hm2: homerow_mods2 {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS2";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <180>;
          flavor = "hold-preferred";
          bindings = <&mo>, <&kp>;
      };

      hm3: homerow_mods3 {
          compatible = "zmk,behavior-hold-tap";
          label = "HOMEROW_MODS3";
          #binding-cells = <2>;
          tapping-term-ms = <200>;
          quick_tap_ms = <180>;
          flavor = "hold-preferred";
          bindings = <&kp>, <&kp>;
      };

      td_sft: tap_dance_mod_tap {
        compatible = "zmk,behavior-tap-dance";
        #binding-cells = <0>;
        tapping-term-ms = <200>;
        bindings = <&sk LSHFT>, <&caps_word>;
      };
    };

    keymap {
        compatible = "zmk,keymap";


        /* default_layer { */
        /*   bindings = < */
        /*     &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4    &kp N5 &tog KP                                                              &mo MOD  &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp BSLH */
        /*     &kp TAB   &kp Q     &kp W    &kp E    &kp R     &kp T  &tog DEFR                                                            &tog DEF &kp Y  &kp U  &kp I     &kp O    &kp P    &kp MINUS */
        /*     &kp ESC   &kp A     &kp S    &kp D    &kp F     &kp G  &kp CAPS           &kp LCTRL &kp LALT  &kp LGUI  &kp RCTRL           &tog FN  &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT */
        /*     &td_sft   &kp Z     &kp X    &kp C    &kp V     &kp B                               &kp DEL   &kp TAB                                &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &td_sft  */
        /*     &mo FN    &kp GRAVE &kp LGUI &kp LEFT &kp RIGHT                  &kp BSPC &mo FN    &kp LANG2 &kp LANG1 &kp ENTER &kp SPACE                 &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo FN */
        /*   >; */
        /* }; */

        default_layer {
          bindings = <
            &kp EQUAL &n1ar &n2ar   &n3ar    &n4ar     &n5ar &tog KP                                                                  &mo MOD  &n6ar &n7ar    &n8ar   &n9ar    &n0ar    &kp MINUS
            &kp TAB   &kp Q &kp W   &kp E    &kp R     &kp T &to BREV                                                                 &to JISR &kp Y &kp U    &kp I   &kp O    &kp P    &kp BSLH
            &kp ESC   &kp A &kp S   &kp D    &kp F     &kp G &to BASE          &kp LCTRL &kp LGUI      &kp RGUI  &kp RCTRL            &to JIS  &kp H &kp J    &kp K   &kp L    &kp SEMI &kp SQT
            &ltgra    &kp Z &kp X   &kp C    &kp V     &kp B                             &kp LALT      &kp RALT                                &kp N &kp M    &comcom &dotdot  &kp FSLH &gttld
            &kp INS   &caa  &kp LCS &kp LEFT &kp RIGHT                &kp BSPC &td_sft   &lt SYM LANG2 &kp LANG1 &kp ENTER &kp SPACE                 &kp DOWN &kp UP  &kp RCS  &dha     &kp DEL 
          >;
        };

        /* default_layer { */
        /*   bindings = < */
        /*     &kp EQUAL &kp N1    &kp N2    &kp N3   &kp N4    &kp N5 &ktog KP                                                            &mo MOD  &kp N6 &kp N7   &kp N8    &kp N9   &kp N0   &kp MINUS  */
        /*     &kp TAB   &kp Q     &kp W     &kp E    &kp R     &kp T  &to BASE                                                            &to BJIS &kp Y  &kp U    &kp I     &kp O    &kp P    &kp BSLH  */
        /*     &kp ESC   &kp A     &kp S     &kp D    &kp F     &kp G  &to DEF           &kp LCTRL &kp LGUI  &kp RGUI  &kp RCTRL           &kp RPAR &kp H  &kp J    &kp K     &kp L    &kp SEMI &kp SQT */
        /*     &td_sft   &kp Z     &kp X     &kp C    &kp V     &kp B                              &kp LALT  &kp RALT                               &kp N  &kp M    &kp COMMA &kp DOT  &kp FSLH &td_sft */
        /*     &kp LCS   &kp GRAVE &tog BJIS &kp LEFT &kp RIGHT                 &kp BSPC &mo SYM   &kp LANG2 &kp LANG1 &kp ENTER &kp SPACE                 &kp DOWN &kp UP    &mo MOD  &mo SYM  &kp LCS  */
        /*   >; */
        /* }; */

        layer_symbol_with_jis {
          bindings = <
            &kp CAD &kp F1 &kp F2      &kp F3   &kp F4   &kp F5 &none                                     &none &kp F6   &kp F7   &kp F8 &kp F9    &kp F10 &kp F11
            &kp CAI &none  &none       &kp RBRC &kp PIPE &none  &none                                     &none &none    &none    &none  &none     &none   &kp F12
            &kp SI  &none  &kp UNDER   &kp STAR &kp LPAR &none  &none       &none &none &none &none       &none &kp LEFT &kp DOWN &kp UP &kp RIGHT &none   &kp F13
            &none   &none  &kp KP_PLUS &kp RBKT &kp BSLH &none                    &none &none                   &none    &none    &none  &none     &none   &kp F14
            &none   &none  &none       &none    &none                 &none &none &none &none &none &none                &none    &none  &none     &none   &kp F15
          >;
        };

        layer_symbol {
          bindings = <
            &kp GRAVE &kp F1    &kp F2    &kp F3    &kp F4   &kp F5    &none                                              &none &kp F6 &kp F7   &kp F8   &kp F9    &kp F10  &kp F11
            &kp EXCL  &kp COMMA &kp SQT   &kp DQT   &kp SEMI &kp QMARK &none                                              &none &none  &kp LBRC &kp RBRC &none     &kp AT   &kp F12
            &kp HASH  &kp CARET &kp EQUAL &kp UNDER &kp DLLR &kp STAR  &none       &none &none &kp DOT &kp STAR           &none &none  &kp LPAR &kp RPAR &kp PRCNT &kp AMPS &kp F13
            &kp TILDE &kp LT    &kp PIPE  &kp MINUS &kp GT   &kp FSLH                    &none &none                            &none  &kp LBKT &kp RBKT &none     &none    &kp F14
            &none     &none     &none     &none     &none                    &none &none &none &none   &kp COLON &kp SEMI              &none    &none    &none     &none    &kp F15
          >;
        };

        layer_qwerty {
          bindings = <
            &kp EQUAL &kp N1    &kp N2   &kp N3   &kp N4    &kp N5 &tog KP                                                            &mo MOD  &kp N6 &kp N7 &kp N8    &kp N9   &kp N0   &kp MINUS
            &kp TAB   &kp Q     &kp W    &kp E    &kp R     &kp T  &to BREV                                                           &to JISR &kp Y  &kp U  &kp I     &kp O    &kp P    &kp BSLH
            &kp ESC   &kp A     &kp S    &kp D    &kp F     &kp G  &to BASE          &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &to JIS  &kp H  &kp J  &kp K     &kp L    &kp SEMI &kp SQT
            &sk LSHFT &kp Z     &kp X    &kp C    &kp V     &kp B                              &kp HOME &kp PG_UP                              &kp N  &kp M  &kp COMMA &kp DOT  &kp FSLH &sk RSHFT
            &mo FN    &kp GRAVE &kp LGUI &kp LEFT &kp RIGHT                 &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp SPACE                 &kp UP &kp DOWN  &kp LBKT &kp RBKT &mo FN
          >;
        };

        layer_qwerty_reverse {
          bindings = <
            &kp EQUAL &kp N1 &kp N2  &kp N3   &kp N4    &kp N5 &tog KP                                                                 &mo MOD  &kp N6 &kp N7 &kp N8    &kp N9  &kp N0   &kp MINUS
            &kp TAB   &kp Q  &kp W   &kp E    &kp R     &kp T  &to BREV                                                                &to JISR &kp Y  &kp U  &kp I     &kp O   &kp P    &kp BSLH
            &kp ESC   &kp A  &kp S   &kp D    &kp F     &kp G  &to BASE          &kp LCTRL &kp LGUI      &kp RGUI  &kp RCTRL           &to JIS  &kp H  &kp J  &kp K     &kp L   &kp SEMI &kp SQT
            &ltgra    &kp Z  &kp X   &kp C    &kp V     &kp B                              &kp LALT      &kp RALT                               &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH &gttld
            &kp INS   &caa   &kp LCS &kp LEFT &kp RIGHT                 &kp BSPC &td_sft   &lt SYM LANG2 &kp LANG1 &kp ENTER &kp SPACE                 &kp UP &kp DOWN  &mo DEL &dha     &kp DEL 
          >;
        };

        jis {
          bindings = <
            &epj    &n1jr &n2jr   &n3jr    &n4jr     &n5jr &tog KP                                                                  &mo MOD  &n6jr &n7jr    &n8jr   &n9jr   &n0jr    &muj
            &kp TAB &kp Q &kp W   &kp E    &kp R     &kp T &to BREV                                                                 &to JISR &kp Y &kp U    &kp I   &kp O   &kp P    &bpj
            &kp ESC &kp A &kp S   &kp D    &kp F     &kp G &to BASE          &kp LCTRL &kp LGUI       &kp RGUI  &kp RCTRL           &to JIS  &kp H &kp J    &kp K   &kp L   &scj     &qdj
            &ltgraj &kp Z &kp X   &kp C    &kp V     &kp B                             &kp LALT       &kp RALT                               &kp N &kp M    &comcom &dotdot &kp FSLH &gttldj
            &kp INS &caj  &kp LCS &kp LEFT &kp RIGHT                &kp BSPC &td_sft   &lt SYMJ LANG2 &kp LANG1 &kp ENTER &kp SPACE                &kp DOWN &kp UP  &kp RCS &dhj     &kp DEL 
          >;
        };

        jis_reverse {
          bindings = <
            &epj    &kp N1 &n2j    &kp N3   &kp N4    &kp N5 &tog KP                                                                  &mo MOD  &n6j   &n7j     &n8j      &n9j    &n0j     &muj
            &kp TAB &kp Q  &kp W   &kp E    &kp R     &kp T  &to BREV                                                                 &to JISR &kp Y  &kp U    &kp I     &kp O   &kp P    &bpj
            &kp ESC &kp A  &kp S   &kp D    &kp F     &kp G  &to BASE          &kp LCTRL &kp LGUI       &kp RGUI  &ctrld              &to JIS  &kp H  &kp J    &kp K     &kp L   &scj     &qdj
            &ltgraj &kp Z  &kp X   &kp C    &kp V     &kp B                              &kp LALT       &kp RALT                               &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &gttldj
            &kp INS &caj   &kp LCS &kp LEFT &kp RIGHT                 &kp BSPC &td_sft   &lt SYMJ LANG2 &kp LANG1 &kp ENTER &kp SPACE                 &kp DOWN &kp UP    &kp RCS &dhj     &kp DEL 
          >;
        };

        default_layer_linux {
          bindings = <
            &kp EQUAL &n1ar     &n1ar    &n3ar    &n4ar     &n5ar &tog KP                                                            &mo MOD  &n6ar &n7ar  &n8ar     &n9ar    &n0ar    &kp MINUS
            &kp TAB   &kp Q     &kp W    &kp E    &kp R     &kp T &to BREV                                                           &to JISR &kp Y &kp U  &kp I     &kp O    &kp P    &kp BSLH
            &kp ESC   &kp A     &kp S    &kp D    &kp F     &kp G &to BASE          &kp LCTRL &kp LALT &kp LGUI &kp RCTRL            &to JIS  &kp H &kp J  &kp K     &kp L    &kp SEMI &kp SQT
            &caa      &kp Z     &kp X    &kp C    &kp V     &kp B                             &kp LCS  &kp RCS                                &kp N &kp M  &kp COMMA &kp DOT  &kp FSLH &dha
            &mo FN    &kp GRAVE &kp LGUI &kp LEFT &kp RIGHT                &kp BSPC &td_sft   &kp INT5 &kp INT4 &kp ENTER &kp SPACE                 &kp UP &kp DOWN  &kp LALT &kp DEL  &mo FN 
          >;
        };

        layer_keypad {
          bindings = <
            &kp GRAVE &kp N1  &kp N2    &kp N3   &kp N4    &kp N5 &tog KP                                                           &mo MOD &kp N6 &kp KP_NUM &kp N8    &kp KP_DIVIDE &kp KP_MULTIPLY &kp MINUS
            &kp TAB   &kp Q   &kp W     &kp E    &kp R     &kp T  &none                                                             &none   &kp Y  &kp KP_N7  &kp KP_N8 &kp KP_N9     &kp KP_MINUS    &kp LEFT_BRACKET
            &kp CAPS  &kp A   &kp S     &kp D    &kp F     &kp G  &none            &kp LCTRL &kp LALT &kp LGUI  &kp RCTRL           &none   &kp H  &kp KP_N4  &kp KP_N5 &kp KP_N6     &kp KP_PLUS     &kp SINGLE_QUOTE
            &sk LSHFT &kp Z   &kp X     &kp C    &kp V     &kp B                             &kp HOME &kp PG_UP                             &kp N  &kp KP_N1  &kp KP_N2 &kp KP_N3     &kp KP_ENTER    &sk RSHFT
            &mo FN    &kp ESC &kp EQUAL &kp LEFT &kp RIGHT                &kp BSPC &kp DEL   &kp END  &kp PG_DN &kp ENTER &kp KP_N0                &kp UP     &kp DOWN  &kp KP_DOT    &kp KP_ENTER    &mo FN
          >;
        };

        layer_fn {
          bindings = <
            &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog KP                                                                        &mo MOD &kp F7    &kp F8    &kp F9  &kp F10   &kp F11   &kp F12
            &trans &trans &kp N7 &kp N8 &kp N9 &trans &none                                                                          &none   &trans    &kp N7    &kp N8  &kp N9    &kp FSLH  &kp F13
            &trans &trans &kp N4 &kp N4 &kp N6 &trans &none           &trans &trans               &trans            &trans           &none   &kp DOT   &kp N4    &kp N5  &kp N6    &kp STAR  &kp F14
            &trans &kp N0 &kp N1 &kp N2 &kp N3 &trans                        &kp C_BRIGHTNESS_INC &kp C_VOLUME_UP                            &kp SPACE &kp N1    &kp N2  &kp N3    &kp MINUS &kp F15
            &trans &trans &trans &trans &trans                &trans  &trans &kp C_BRIGHTNESS_DEC &kp C_VOLUME_DOWN &trans &kp KP_N0                   &kp COMMA &kp DOT &kp EQUAL &kp PLUS  &kp F16
         >;
        };

        /* layer_fn { */
        /*   bindings = < */
        /*     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6 &tog KP                                                                         &mo MOD  &kp F7    &kp F8    &kp F9     &kp F10    &kp F11  &kp F12 */
        /*     &trans  &trans  &trans  &trans  &trans  &trans &none                                                                           &none    &kp LBRC  &kp RBRC  &kp MINUS  &kp PLUS   &trans   &trans */
        /*     &trans  &trans  &trans  &trans  &trans  &trans &none          &trans  &trans                &trans             &trans          &none    &kp LPAR  &kp RPAR  &kp UNDER  &kp EQUAL  &trans   &trans */
        /*     &trans  &trans  &trans  &trans  &trans  &trans                        &kp C_BRIGHTNESS_INC  &kp C_VOLUME_UP                             &kp LBKT  &kp RBKT  &trans     &trans     &trans   &trans */
        /*     &trans  &trans  &trans  &trans  &trans                &trans  &trans  &kp C_BRIGHTNESS_DEC  &kp C_VOLUME_DOWN  &trans  &trans                     &trans    &trans     &trans     &trans   &trans */
        /*   >; */
        /* }; */

        layer_fn_jis {
          bindings = <
            &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &tog KP                                                                   &mo MOD &kp F7    &kp F8    &kp F9  &kp F10   &kp F11   &kp F12
            &trans &trans &kp N7 &kp N8 &kp N9 &trans &none                                                                     &none   &trans    &kp N7    &kp N8  &kp N9    &kp FSLH  &kp F13
            &trans &trans &kp N4 &kp N6 &kp N7 &trans &none         &trans &trans               &trans            &trans        &none   &kp SPACE &kp N4    &kp N5  &kp N6    &kp DQT   &kp F14
            &trans &kp N0 &kp N1 &kp N2 &kp N3 &trans                      &kp C_BRIGHTNESS_INC &kp C_VOLUME_UP                         &trans    &kp N1    &kp N2  &kp N3    &kp MINUS &kp F15
            &trans &trans &trans &trans &trans               &trans &trans &kp C_BRIGHTNESS_DEC &kp C_VOLUME_DOWN &trans &kp N0                   &kp COMMA &kp DOT &kp EQUAL &kp PLUS  &kp F16
          >;
        };

        layer_mod {
          bindings = <
            &none &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &none                                                               &trans                 &none &none      &none      &none &none &none
            &none &none        &none        &none        &none        &none        &bootloader                                                         &bootloader            &none &none      &none      &none &none &none
            &none &bt0         &bt1         &none        &none        &none        &none             &none &none &bt BT_CLR &none                      &rgb_ug RGB_MEFS_CMD 5 &none &none      &none      &none &none &none
            &none &none        &none        &none        &macro_ver   &none                                &none &none                                                        &none &none      &none      &none &none &none
            &none &none        &none        &none        &none                                 &none &none &none &none      &bl BL_TOG &rgb_ug RGB_TOG                        &bl BL_INC &bl BL_DEC &none &none &none
          >;
        };

    };
};
