// Define mod-morph with a *single* mod trigger for less repetition.
#define SIMPLE_MORPH(NAME, MOD, BINDING1, BINDING2)                            \
  ZMK_MOD_MORPH(NAME, mods = <(MOD_L##MOD | MOD_R##MOD)>;                      \
                bindings = <BINDING1>, <BINDING2>;)

/* Programmer's Qwerty shifts morphs */
SIMPLE_MORPH(star_n1,         SFT, STAR,  N1      )
SIMPLE_MORPH(lbkt_n2,         SFT, LBKT,  N2      )
SIMPLE_MORPH(lbrc_n3,         SFT, LBRC,  N3      )
SIMPLE_MORPH(lpar_n4,         SFT, LPAR,  N4      )
SIMPLE_MORPH(hash_n5,         SFT, HASH,  N5      )
SIMPLE_MORPH(caret_n6,        SFT, CARET, N6      )
SIMPLE_MORPH(rpar_n7,         SFT, RPAR,  N7      )
SIMPLE_MORPH(rbrc_n8,         SFT, RBRC,  N8      )
SIMPLE_MORPH(rbkt_n9,         SFT, RBKT,  N9      )
SIMPLE_MORPH(dllr_n0,         SFT, DLLR,  N0      )
SIMPLE_MORPH(excl_gt,         SFT, EXCL,  GT      )
SIMPLE_MORPH(at_lt,           SFT, AT,    LT      )
SIMPLE_MORPH(prcnt_amps,      SFT, PRCNT, AMPS    )
SIMPLE_MORPH(comma_comma,     SFT, COMMA, COMMA   )
SIMPLE_MORPH(dot_dot,         SFT, DOT,   DOT     )
/* Programmer's Qwerty shifts morphs with JIS */
SIMPLE_MORPH(jis_star_n1,     SFT, DQT,   N1      )
SIMPLE_MORPH(jis_lbkt_n2,     SFT, RBKT,  N2      )
SIMPLE_MORPH(jis_lbrc_n3,     SFT, RBRC,  N3      )
SIMPLE_MORPH(jis_lpar_n4,     SFT, STAR,  N4      )
SIMPLE_MORPH(jis_hash_n5,     SFT, HASH,  N5      )
SIMPLE_MORPH(jis_caret_n6,    SFT, EQUAL, N6      )
SIMPLE_MORPH(jis_rpar_n7,     SFT, LPAR,  N7      )
SIMPLE_MORPH(jis_rbrc_n8,     SFT, PIPE,  N8      )
SIMPLE_MORPH(jis_rbkt_n9,     SFT, BSLH,  N9      )
SIMPLE_MORPH(jis_dllr_n0,     SFT, DLLR,  N0      )
SIMPLE_MORPH(jis_excl_gt,     SFT, EXCL,  GT      )
SIMPLE_MORPH(jis_at_lt,       SFT, LBKT,  LT      )
SIMPLE_MORPH(jis_prcnt_amps,  SFT, PRCNT, CARET   )
SIMPLE_MORPH(jis_grave_tilde, SFT, LBRC,  PLUS    )
SIMPLE_MORPH(jis_equal_plus,  SFT, UNDER, LS(SEMI))
SIMPLE_MORPH(jis_minus_under, SFT, MINUS, LS(INT1))
SIMPLE_MORPH(jis_bslh_pipe,   SFT, INT3,  LS(INT3))
SIMPLE_MORPH(jis_sqt_dqt,     SFT, AMPS,  AT      )
SIMPLE_MORPH(jis_semi_colon,  SFT, SEMI,  SQT     )
/* Convert from JIS to ANSI */
SIMPLE_MORPH(aj_n2_at,       SFT, N2, LBKT       )
SIMPLE_MORPH(aj_n6_caret,    SFT, N6, EQUAL      )
SIMPLE_MORPH(aj_n7_amps,     SFT, N7, CARET      )
SIMPLE_MORPH(aj_n8_star,     SFT, N8, DQT        )
SIMPLE_MORPH(aj_n9_lpar,     SFT, N9, STAR       )
SIMPLE_MORPH(aj_n0_rpar,     SFT, N0, LPAR       )

